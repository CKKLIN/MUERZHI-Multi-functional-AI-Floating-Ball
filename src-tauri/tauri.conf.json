{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUERZHI",
  "version": "1.1.0",
  "identifier": "com.muerzhi.aiball",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:21047",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "二支录制",
        "url": "index.html",
        "width": 550,
        "height": 420,
        "minWidth": 420,
        "minHeight": 340,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#eaeaec"
      },
      {
        "label": "ai",
        "title": "AI 助手",
        "url": "index.html#/ai",
        "width": 480,
        "height": 540,
        "minWidth": 400,
        "minHeight": 400,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#eaeaec"
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "index.html#/settings",
        "width": 420,
        "height": 480,
        "minWidth": 380,
        "minHeight": 420,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#eaeaec"
      },
      {
        "label": "todo",
        "title": "待办便签",
        "url": "index.html#/todo",
        "width": 420,
        "height": 520,
        "minWidth": 380,
        "minHeight": 400,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#eaeaec"
      },
      {
        "label": "about",
        "title": "关于",
        "url": "index.html#/about",
        "width": 360,
        "height": 400,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#eaeaec"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/logo.ico", "../public/logo.png"],
    "resources": {
      "../vendor/ffmpeg/ffmpeg.exe": "ffmpeg.exe",
      "../src-tauri/resources/clawd-hook.js": "clawd-hook.js"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
