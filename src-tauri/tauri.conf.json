{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MUERZHI",
  "version": "1.1.0",
  "identifier": "com.muerzhi.aiball",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:21047",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "二支录制",
        "url": "index.html",
        "width": 550,
        "height": 420,
        "minWidth": 420,
        "minHeight": 340,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#eaeaec"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/logo.ico", "../public/logo.png"],
    "resources": {
      "../vendor/ffmpeg/ffmpeg.exe": "ffmpeg.exe",
      "../electron/main/clawd-hook.js": "clawd-hook.js",
      "../electron/main/question-card-utils.js": "question-card-utils.js"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
